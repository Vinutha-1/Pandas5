import pandas as pd

def department_highest_salary(employee: pd.DataFrame, department: pd.DataFrame) -> pd.DataFrame:
    emp_dept=employee.merge(right=department, how='inner', left_on='departmentId', right_on='id',suffixes=['_emp','_dept'])
    emp_dept['rank']= emp_dept.groupby(by = 'departmentId')[['salary']].rank(method='dense', ascending = False)
    result= emp_dept[emp_dept['rank']==1]
    return result[['name_dept','name_emp','salary']].rename(columns= {'name_dept':'Department', 'name_emp':'Employee'
,'salary' :'Salary'})
